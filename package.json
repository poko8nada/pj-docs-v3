{
  "name": "project-starter",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "rm -rf dist",
    "test": "vitest --passWithNoTests",
    "test:run": "vitest run --passWithNoTests",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix && oxfmt",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "typecheck:staged": "node scripts/typecheck-staged.mjs",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "lefthook": "^1.11.0",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.0.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "6.0.3",
    "vitest": "^4.0.18"
  }
}
